<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { background-color: #f9f9f9; margin: 0; padding: 20px; }
        .wrapper { max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05); border: 1px solid #eeeeee; }
        .header-bar { background-color: #2c3e50; padding: 20px; text-align: center; }
        .content { font-family: 'Segoe UI', Arial, sans-serif; padding: 40px; text-align: center; line-height: 1.6; }
        .title { color: #333333; font-size: 24px; font-weight: 700; margin-bottom: 10px; }
        .subtitle { color: #666666; font-size: 16px; margin-bottom: 30px; }
        .otp-box { background-color: #fff7ed; border: 2px dashed #f97316; border-radius: 8px; padding: 20px; display: inline-block; margin: 20px 0; }
        .otp-code { color: #ea580c; font-size: 36px; font-weight: 800; letter-spacing: 8px; margin: 0; }
        .warning { background-color: #fff1f2; color: #be123c; padding: 15px; border-radius: 6px; font-size: 13px; margin-top: 30px; }
        .footer { background-color: #f8fafc; padding: 20px; text-align: center; color: #94a3b8; font-size: 12px; border-top: 1px solid #edf2f7; }
        .logo-text { color: #ffffff; font-size: 22px; font-weight: bold; text-decoration: none; }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="header-bar">
            <span class="logo-text">PhoneBazar 📱</span>
        </div>

        <div class="content">
            <div class="title">Password Reset</div>
            <p class="subtitle">Hi {{ firstname }}, we received a request to reset your password. Use the verification code below to proceed.</p>
            
            <div class="otp-box">
                <h1 class="otp-code">{{ otp }}</h1>
            </div>

            <p style="color: #64748b; font-size: 14px;">This code is valid for 10 minutes. Please do not share this code with anyone for security reasons.</p>

            <div class="warning">
                <strong>Didn't request this?</strong> If you didn't try to reset your password, please ignore this email or contact our support team immediately.
            </div>
        </div>

        <div class="footer">
            &copy; 2026 PhoneBazar | Your Trusted Mobile Marketplace<br>
            Surat, Gujarat, India
        </div>
    </div>
</body>
</html>